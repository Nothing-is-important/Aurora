{
  "name": "aurora",
  "productName": "Aurora",
  "version": "0.9.1",
  "description": "苹果风格 DeepSeek Harness 桌面工作台",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && tsc -p electron/tsconfig.main.json",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.main.json --noEmit",
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "sql.js": "^1.13.0",
    "undici": "^8.10.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.1.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "highlight.js": "^11.10.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.460.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  },
  "build": {
    "appId": "com.aurora.workbench",
    "productName": "Aurora",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts/mock-mcp-server.mjs",
        "to": "mock-mcp-server.mjs"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aurora"
    }
  }
}
